<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kbulkup.training.mapper.TrainingMapper">

    <insert id="createTraining" useGeneratedKeys="true" keyProperty="trainingId">
        INSERT INTO trainings (
            trainer_id,
            title,
            description,
            price,
            category,
            level,
            thumbnail_url,
            approval_status,
            created_at,
            updated_at
        ) VALUES (
                     #{trainerId},
                     #{title},
                     #{description},
                     #{price},
                     #{category},
                     #{level},
                     #{thumbnailUrl},
                     '대기',
                     NOW(),
                     NOW()
                 )
    </insert>
</mapper>
