<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kbulkup.certificates.mapper.CertificatesMapper">

    <insert id="createTrainerCertification"
            parameterType="com.kbulkup.certificates.dto.request.CertificateCreateRequestDTO">
        INSERT INTO trainer_certificates (
            trainer_id,
            cert_type,
            cert_number,
            created_at
        ) VALUES (
             #{trainerID},
             #{certType},
             #{certNumber},
             NOW()
        )
    </insert>

</mapper>